-/**
- * @brief Get the default configuration parameters
- *
- * @param parameters EVE_Hal framework's parameters
- * @param deviceIdx
- * @return true
- */
-bool EVE_HalImpl_defaults(EVE_HalParameters *parameters, size_t deviceIdx)
-{
