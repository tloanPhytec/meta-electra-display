-
-	if (ret)
-	{
-		/* Interface 1 is SPI master */
-		status = FT4222_SPIMaster_Init(
-		    phost->SpiHandle,
-		    SPI_IO_SINGLE,
-		    seldiv,
-		    CLK_IDLE_LOW, //,CLK_IDLE_HIGH
