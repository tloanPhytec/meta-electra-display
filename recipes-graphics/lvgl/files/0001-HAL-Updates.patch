-			eve_printf_debug("FT4222_SPI_SetDrivingStrength failed!\n");
-		}
-
-		EVE_sleep(20);
-
-		status = FT4222_SetSuspendOut(phost->GpioHandle, false);
-		if (status != FT4222_OK)
-		{
-			eve_printf_debug("Disable suspend out function on GPIO2 failed!\n");
