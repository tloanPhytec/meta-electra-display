-		}
-		phost->SpiCsPin = parameters->SpiCsPin;
-		phost->PowerDownPin = parameters->PowerDownPin;
-
-		status = FT4222_SPI_SetDrivingStrength(phost->SpiHandle, DS_4MA, DS_4MA, DS_4MA);
-		if (status != FT4222_OK)
