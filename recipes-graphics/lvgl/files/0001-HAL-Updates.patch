-		else
-			ftRes = FT_Write(phost->GpioHandle, &pwd0, 1, &written);
-		if (ftRes != FT_OK)
-			res = false;
-
-		eve_assert(ftRes == FT_OK);
-		EVE_sleep(20);
-	}
-	return res;
-}
