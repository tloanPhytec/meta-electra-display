--- a/common/eve_hal/EVE_HalImpl_LINUX.c
+++ b/common/eve_hal/EVE_HalImpl_LINUX.c
@@ -33,6 +33,45 @@
 #include "EVE_Platform.h"
 #if defined(__linux__)
 
+#include <linux/spi/spidev.h>
+#include <sys/ioctl.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <string.h>
+#include <stdlib.h>
+#include <stdio.h>
+
+static int spi_fd = -1;
+static uint32_t spi_buf_size = (1024 * 1024 + 16);
+static uint8_t *spi_tx_buf = NULL;
+static uint8_t *spi_rx_buf = NULL;
+static int spi_idx = 0;
+static bool spi_is_read = false;
+
+static void ensure_spi_buf(uint32_t needed) {
+       if (spi_idx + needed > spi_buf_size) {
+               spi_buf_size = spi_idx + needed + (1024 * 1024);
+               spi_tx_buf = realloc(spi_tx_buf, spi_buf_size);
+               spi_rx_buf = realloc(spi_rx_buf, spi_buf_size);
+       }
+}
+
+static void advance_read_addr(uint32_t bytes) {
+       uint32_t addr = ((spi_tx_buf[0] & 0x3F) << 16) | (spi_tx_buf[1] << 8) | spi_tx_buf[2];
+       addr += bytes;
+       spi_tx_buf[0] = (addr >> 16) & 0x3F;
+       spi_tx_buf[1] = (addr >> 8) & 0xFF;
+       spi_tx_buf[2] = addr & 0xFF;
+}
+
+static void spi_xfer(int len) {
+	if (!spi_tx_buf || !spi_rx_buf) return;
+	struct spi_ioc_transfer tr = { .tx_buf = (unsigned long)spi_tx_buf, .rx_buf = (unsigned long)spi_rx_buf, .len = len };
+	if (ioctl(spi_fd, SPI_IOC_MESSAGE(1), &tr) < 0) {
+		perror("SPI xfer failed (check kernel spidev bufsiz)");
+	}
+}
+
 /************
 ** UTILITY **
 ************/
@@ -153,6 +192,146 @@ void EVE_sleep(uint32_t ms)
 #endif
 }
 
+void EVE_HalImpl_initialize(void) {}
+void EVE_HalImpl_release(void) {}
+bool EVE_HalImpl_defaults(EVE_HalParameters *parameters, size_t deviceIdx) { return true; }
+
+bool EVE_HalImpl_open(EVE_HalContext *phost, const EVE_HalParameters *parameters) {
+	spi_fd = open("/dev/spidev2.0", O_RDWR); // Change to match your AM64x spidev node
+	if (spi_fd < 0) return false;
+	uint8_t mode = 0;
+	uint32_t speed = 16000000;
+	ioctl(spi_fd, SPI_IOC_WR_MODE, &mode);
+	ioctl(spi_fd, SPI_IOC_WR_MAX_SPEED_HZ, &speed);
+	if (!spi_tx_buf) spi_tx_buf = malloc(spi_buf_size);
+        if (!spi_rx_buf) spi_rx_buf = malloc(spi_buf_size);
+	return (spi_tx_buf && spi_rx_buf);
+}
+
+void EVE_HalImpl_close(EVE_HalContext *phost) {
+	if (spi_fd >= 0) close(spi_fd); spi_fd = -1;
+	if (spi_tx_buf) { free(spi_tx_buf); spi_tx_buf = NULL; }
+	if (spi_rx_buf) { free(spi_rx_buf); spi_rx_buf = NULL; }
+}
+
+void EVE_HalImpl_idle(EVE_HalContext *phost) {}
+
+void EVE_Hal_startTransfer(EVE_HalContext *phost, EVE_TRANSFER_T rw, uint32_t addr) {
+	phost->Status = (rw == EVE_TRANSFER_READ) ? EVE_STATUS_READING : EVE_STATUS_WRITING;
+	spi_is_read = (rw == EVE_TRANSFER_READ);
+	spi_idx = 0;
+	ensure_spi_buf(4);
+	spi_tx_buf[spi_idx++] = (rw == EVE_TRANSFER_WRITE ? 0x80 : 0x00) | ((addr >> 16) & 0x3F);
+	spi_tx_buf[spi_idx++] = (addr >> 8) & 0xFF;
+	spi_tx_buf[spi_idx++] = addr & 0xFF;
+	if (spi_is_read) spi_tx_buf[spi_idx++] = 0x00; // Dummy byte
+}
+void EVE_Hal_endTransfer(EVE_HalContext *phost) {
+	if (!spi_is_read && spi_idx > 3) {
+               uint32_t total = spi_idx - 3;
+               uint32_t offset = 3;
+               uint32_t start_addr = ((spi_tx_buf[0] & 0x3F) << 16) | (spi_tx_buf[1] << 8) | spi_tx_buf[2];
+
+               while (total > 0) {
+                       uint32_t chunk = (total > 65533) ? 65533 : total;
+
+                       uint8_t header[3];
+		       uint32_t addr = start_addr + (offset - 3);
+		       header[0] = 0x80 | ((addr >> 16) & 0x3F);
+                       header[1] = (addr >> 8) & 0xFF;
+                       header[2] = addr & 0xFF;
+
+                       struct spi_ioc_transfer tr[2];
+                       memset(tr, 0, sizeof(tr));
+                       tr[0].tx_buf = (unsigned long)header;
+                       tr[0].len = 3;
+                       tr[1].tx_buf = (unsigned long)&spi_tx_buf[offset];
+                       tr[1].len = chunk;
+                       
+                       if (ioctl(spi_fd, SPI_IOC_MESSAGE(2), tr) < 0) perror("SPI xfer failed");
+
+                       total -= chunk;
+                       offset += chunk;
+               }
+       }
+       spi_idx = 0;
+       phost->Status = EVE_STATUS_OPENED;
+}
+
+void EVE_Hal_flush(EVE_HalContext *phost) {}
+
+uint8_t EVE_Hal_transfer8(EVE_HalContext *phost, uint8_t value) {
+	ensure_spi_buf(1);
+	if (spi_is_read) {
+               spi_tx_buf[4] = 0; spi_xfer(5);
+               advance_read_addr(1); return spi_rx_buf[4];
+        }
+        spi_tx_buf[spi_idx++] = value; return 0;
+}
+uint16_t EVE_Hal_transfer16(EVE_HalContext *phost, uint16_t value) {
+	ensure_spi_buf(2);
+	if (spi_is_read) {
+               spi_tx_buf[4] = 0; spi_tx_buf[5] = 0; spi_xfer(6);
+               advance_read_addr(2); return spi_rx_buf[4] | (spi_rx_buf[5] << 8);
+        }
+        spi_tx_buf[spi_idx++] = value & 0xFF; spi_tx_buf[spi_idx++] = (value >> 8) & 0xFF;
+        return 0;
+}
+uint32_t EVE_Hal_transfer32(EVE_HalContext *phost, uint32_t value) {
+	ensure_spi_buf(4);
+	if (spi_is_read) {
+               spi_tx_buf[4] = 0; spi_tx_buf[5] = 0; spi_tx_buf[6] = 0; spi_tx_buf[7] = 0; spi_xfer(8);
+               advance_read_addr(4); return spi_rx_buf[4] | (spi_rx_buf[5] << 8) | (spi_rx_buf[6] << 16) | (spi_rx_buf[7] << 24);
+        }
+        spi_tx_buf[spi_idx++] = value & 0xFF; spi_tx_buf[spi_idx++] = (value >> 8) & 0xFF;
+        spi_tx_buf[spi_idx++] = (value >> 16) & 0xFF; spi_tx_buf[spi_idx++] = (value >> 24) & 0xFF;
+        return 0;
+}
+void EVE_Hal_transferMem(EVE_HalContext *phost, uint8_t *result, const uint8_t *buffer, uint32_t size) {
+	ensure_spi_buf(size);
+	if (spi_is_read) {
+		uint32_t total = size;
+                uint32_t offset = 0;
+                while (total > 0) {
+                        uint32_t chunk = (total > 65532) ? 65532 : total;
+                        memset(&spi_tx_buf[4], 0, chunk);
+                        spi_xfer(4 + chunk);
+                        if (result) memcpy(result + offset, &spi_rx_buf[4], chunk);
+                        advance_read_addr(chunk);
+                        total -= chunk;
+                        offset += chunk;
+               }
+	} else {
+		if (buffer) memcpy(&spi_tx_buf[spi_idx], buffer, size); else memset(&spi_tx_buf[spi_idx], 0, size);
+		spi_idx += size;
+	}
+}
+void EVE_Hal_transferProgMem(EVE_HalContext *phost, uint8_t *result, eve_progmem_const uint8_t *buffer, uint32_t size) {
+	EVE_Hal_transferMem(phost, result, buffer, size);
+}
+uint32_t EVE_Hal_transferString(EVE_HalContext *phost, const char *str, uint32_t index, uint32_t size, uint32_t padMask) {
+	uint32_t len = 0;
+	while (str[index + len] && len < size) { ensure_spi_buf(1); spi_tx_buf[spi_idx++] = str[index + len]; len++; }
+        ensure_spi_buf(1); spi_tx_buf[spi_idx++] = 0; len++;
+        while (len & padMask) { ensure_spi_buf(1); spi_tx_buf[spi_idx++] = 0; len++; }
+	return len;
+}
+void EVE_Hal_hostCommand(EVE_HalContext *phost, uint8_t cmd) {
+	uint8_t buf[3] = {cmd, 0, 0};
+	struct spi_ioc_transfer tr = { .tx_buf = (unsigned long)buf, .len = 3 };
+	ioctl(spi_fd, SPI_IOC_MESSAGE(1), &tr);
+}
+
+void EVE_Hal_hostCommandExt3(EVE_HalContext *phost, uint32_t cmd) {}
+bool EVE_Hal_powerCycle(EVE_HalContext *phost, bool up) { return true; }
+void EVE_Hal_setSPI(EVE_HalContext *phost, EVE_SPI_CHANNELS_T numchannels, uint8_t numdummy) {}
+void EVE_Hal_restoreSPI(EVE_HalContext *phost) {}
+
+/* Dummy Linker Stubs for Generic App Code */
+const char* BT8XXEMU_version(void) { return "0.0.0"; }
+size_t EVE_Hal_list(void) { return 0; }
+void EVE_Hal_info(EVE_DeviceInfo *deviceInfo, size_t deviceIdx) {}
+
 #endif
 
